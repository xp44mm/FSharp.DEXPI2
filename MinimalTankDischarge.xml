<?xml version="1.0" encoding="utf-8"?>
<!--
  最小 DEXPI 2.0 XML：箱子 V-101 → 底嘴 N1 → 手阀 XV-101 → 管线 PL-101 → 排至下水道
  格式忠实于官方 reference_pid.xml（DEXPI Specification V2.0.0）。
  对象链：
    PlantModel.TaggedPlantItems → Tank(V-101) → Nozzles(N1) → Nodes(PipingNode)
                               → ShutOffValve(XV-101) → Nodes(in/out)
    PlantModel.PipingNetworkSystems → PipingNetworkSystem(PL-101) → Segments →
      Items(PipingConnection): N1Node → XV101In ; XV101Out → Discharge(OffPage)
-->
<Model name="MinimalTankDischarge" uri="http://www.example.org">
  <Import prefix="Core" source="https://data.dexpi.org/models/2.0.0/Core.xml"/>
  <Import prefix="Plant" source="https://data.dexpi.org/models/2.0.0/Plant.xml"/>
  <Object type="Core/EngineeringModel">
    <Components property="ConceptualModel">
      <Object id="PlantModel1" type="Plant/PlantModel">

        <Components property="TaggedPlantItems">
          <!-- ① 箱子（Tank） -->
          <Object id="V101" type="Plant/ProcessEquipment.Tank">
            <Data property="TagName"><String>V-101</String></Data>
            <Components property="Nozzles">
              <Object id="N1" type="Plant/ProcessEquipment.Nozzle">
                <Data property="SubTagName"><String>N1</String></Data>
                <Components property="Nodes">
                  <Object id="N1Node" type="Plant/Piping.PipingNode"/>
                </Components>
              </Object>
            </Components>
          </Object>

          <!-- ② 手阀（ShutOffValve，带进/出两个 PipingNode） -->
          <Object id="XV101" type="Plant/Piping.ShutOffValve">
            <Data property="TagName"><String>XV-101</String></Data>
            <Components property="Nodes">
              <Object id="XV101In"  type="Plant/Piping.PipingNode"/>
              <Object id="XV101Out" type="Plant/Piping.PipingNode"/>
            </Components>
          </Object>
        </Components>

        <!-- ③ 管线：用 PipingConnection 把上面的 PipingNode 串起来 -->
        <Components property="PipingNetworkSystems">
          <Object id="PNS1" type="Plant/Piping.PipingNetworkSystem">
            <Data property="LineNumber"><String>PL-101</String></Data>
            <Components property="Segments">
              <Object id="Seg1" type="Plant/Piping.PipingNetworkSegment">
                <Components property="Items">
                  <Object type="Plant/Piping.PipingConnection">
                    <References objects="#N1Node"  property="SourceItem"/>
                    <References objects="#XV101In" property="TargetItem"/>
                  </Object>
                  <Object type="Plant/Piping.PipingConnection">
                    <References objects="#XV101Out" property="SourceItem"/>
                    <References objects="#Discharge" property="TargetItem"/>
                  </Object>
                </Components>
              </Object>
            </Components>
            <!-- ④ 排放终点：跨页连接器（去下水道/大气） -->
            <Components property="OffPageConnectors">
              <Object id="Discharge" type="Plant/Piping.PipeOffPageConnector">
                <Data property="TagName"><String>To Sewer</String></Data>
              </Object>
            </Components>
          </Object>
        </Components>

      </Object>
    </Components>
  </Object>
</Model>